{
  "expo": {
    "name": "Timer Plus",
    "slug": "timer-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B1B22",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sonoromove.timerplus",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.sonoromove.timerplus",
      "adaptiveIcon": {
        "backgroundColor": "#1B1B22",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-notifications",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1B22",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
